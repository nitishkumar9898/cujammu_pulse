# CUJAMMU EVENTHUB - Environment Variables
# Copy this file to .env and fill in the values

# ─── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
# Configure only after selecting the institutional HTTPS origin; blank disables reset-link email.
APP_RESET_LINK_HOSTS=
CONTEXT_PATH=

# ─── Database ────────────────────────────────────────────────────────────────
# For Docker, use /app/data/eventhub
DB_URL=jdbc:h2:file:./data/eventhub;DB_CLOSE_ON_EXIT=FALSE
DB_USER=sa
DB_PASS=password

# ─── Mail (SMTP) ─────────────────────────────────────────────────────────────
# Get an App Password from Google: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-approved-mailbox@example.com
MAIL_PASS=your-provider-app-password
EMAIL_BACKEND=smtp

# ─── AI Chatbot (Gemini) ─────────────────────────────────────────────────────
# Get an API Key from Google AI Studio: https://aistudio.google.com/
AI_ENABLED=true
AI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-2.0-flash

# ─── Admin Defaults ──────────────────────────────────────────────────────────
ADMIN_EMAIL=nitish.work098@gmail.com
ADMIN_PASS=your-unique-local-admin-password

# ─── Infrastructure ──────────────────────────────────────────────────────────
APP_UPLOAD_DIR=./uploads
THYMELEAF_CACHE=true
HOST_PORT=8080
